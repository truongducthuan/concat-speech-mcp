# concat-speech settings: copy to .env (git ignores it), chmod 600, fill in the keys you have.
# Default speech engine: macos | google | openai | edge | vieneu
CONCAT_SPEECH_ENGINE=macos
# Google Cloud Text-to-Speech API key (engine google)
GOOGLE_TTS_API_KEY=
# OpenAI API key (engine openai)
OPENAI_API_KEY=
# Python of the venv with edge-tts / vieneu (engines edge, vieneu); empty = .venv-tts in this repository
CONCAT_SPEECH_PYTHON=
# Free stock media keys (media_search): pixabay.com/api/docs, pexels.com/api
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Image generation (image_generate), billed per picture. Default engine: openai | gemini (empty = first with a key)
CONCAT_IMAGE_ENGINE=
# Gemini API key from aistudio.google.com (engine gemini); OPENAI_API_KEY above serves engine openai
GEMINI_API_KEY=
# Optional model overrides
OPENAI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=
# Free music / sound effect keys (media_search kinds music, sfx): freesound.org/apiv2/apply, devportal.jamendo.com
FREESOUND_API_KEY=
JAMENDO_CLIENT_ID=
